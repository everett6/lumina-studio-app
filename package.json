{
  "name": "lumina-studio",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "mock": "LUMINA_MOCK=1 node --env-file-if-exists=.env server.js",
    "test": "node --test tests/*.test.js",
    "check": "for f in server.js src/*.js src/*/*.js public/*.js electron/*.js mcp/*.js; do node --check $f || exit 1; done",
    "desktop": "electron .",
    "desktop:mock": "LUMINA_MOCK=1 electron .",
    "dist": "electron-builder --linux deb AppImage",
    "mcp": "node mcp/server.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "docx": "^9.8.1",
    "express": "^5.2.1",
    "pdfkit": "^0.20.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3"
  },
  "description": "Linux-first, bring-your-own-key creative workspace: image generation, editing and a node canvas.",
  "productName": "Lumina Studio",
  "main": "electron/main.js",
  "homepage": "https://github.com/everett6/lumina-studio-app",
  "author": {
    "name": "everett6",
    "email": "everett6@users.noreply.github.com"
  },
  "license": "MIT",
  "build": {
    "appId": "io.github.everett6.lumina-studio",
    "productName": "Lumina Studio",
    "files": [
      "electron/**",
      "src/**",
      "public/**",
      "mcp/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "synopsis": "Bring-your-own-key AI image workspace with a node canvas",
      "executableName": "lumina-studio",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libsecret-1-0"
      ]
    }
  },
  "desktopName": "lumina-studio.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/everett6/lumina-studio-app.git"
  },
  "bugs": {
    "url": "https://github.com/everett6/lumina-studio-app/issues"
  }
}
