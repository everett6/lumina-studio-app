{
  "name": "lumina-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "mock": "LUMINA_MOCK=1 node --env-file-if-exists=.env server.js",
    "test": "node --test tests/*.test.js",
    "check": "node --check server.js && node --check public/app.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3"
  },
  "description": "Linux-first, bring-your-own-key creative workspace: image generation, editing and a node canvas."
}
